{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
		],
		"paths": {
			"@app-components/*": ["./src/app/components/*"],
			"@components-ui/*": ["./src/components/ui/*"],
			"@components-widgets/*": ["./src/components/widgets/*"],
			"@components/*": ["./src/components/*"],
			"@config/*": ["./src/config/*"],
			"@features/*": ["./src/features/*"],
			"@hooks/*": ["./src/hooks/*"],
			"@services/*": ["./src/services/*"],
			"@store/*": ["./src/store/*"],
			"@types/*": ["./src/types/*"],
			"@utils/*": ["./src/utils/*"],
      "@/*": ["./src/*"]
		}
  },
  "include": [
		"../next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		"src/app/pahe.tsx"
	],
  "exclude": [
		"node_modules",
		".next"
	]
}